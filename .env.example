# URL base da Evolution API v2, sem barra no final.
# Exemplo no Easypanel (rede interna): http://evolution_api:8080
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE_NAME=vorcaro
# Aceito como alternativa ao nome acima.
# EVOLUTION_INSTANCE=vorcaro

# JIDs dos grupos de despesas, separados por vírgula.
GRUPOS_DESPESAS=120363411915877448@g.us

GEMINI_API_KEY=sua-chave-gemini
# Opcional. O padrão é gemini-1.5-flash.
# GEMINI_MODEL=gemini-1.5-flash

# Opcional. No container o padrão é sqlite:////app/data/vorcaro.db
# DATABASE_URL=sqlite:////app/data/vorcaro.db

# Porta do uvicorn. O Easypanel injeta PORT; sem a variável o container escuta 80.
# PORT=80

# Opcional: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO

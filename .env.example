# URL base da Evolution API v2, sem barra no final.
# Exemplo no Easypanel (rede interna): http://evolution_api:8080
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE=vorcaro

# Opcional. No container o padrão é sqlite:////app/data/vorcaro.db
# DATABASE_URL=sqlite:////app/data/vorcaro.db

# Opcional: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO
